KZ3 patch 2152 (ENHANCEMENT, experimental): restore the FXAA and gamma input barriers after the XeSS/GPU merge.

Patch 2150 generalized the gamma pass to accept an arbitrary source resource and state. Its barrier hunk matched the
structurally identical block in ld_host_aa instead, leaving the FXAA function with undeclared source/source_state
identifiers and the generalized gamma function with the removed sf identifier. Keep FXAA on its surface render target
and transition the gamma function's supplied source from its supplied state.

diff --git a/libs/video/rsx_live_draw.c b/libs/video/rsx_live_draw.c
--- a/libs/video/rsx_live_draw.c
+++ b/libs/video/rsx_live_draw.c
@@ -18196,9 +18196,9 @@ static int ld_host_aa(u32 i)
     D3D12_RESOURCE_BARRIER b[2] = {0};
     u32 nb = 0;
     b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
-    b[nb].Transition.pResource = source;
+    b[nb].Transition.pResource = sf->tex;
     b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
-    b[nb].Transition.StateBefore = source_state;
+    b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
     b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
     nb++;
     if (g_aa_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
@@ -18333,9 +18333,9 @@ static ID3D12Resource* ld_gamma_present_resource(
     D3D12_RESOURCE_BARRIER b[2] = {0};
     u32 nb = 0;
     b[nb].Type = D3D12_RESOURCE_BARRIER_TYPE_TRANSITION;
-    b[nb].Transition.pResource = sf->tex;
+    b[nb].Transition.pResource = source;
     b[nb].Transition.Subresource = D3D12_RESOURCE_BARRIER_ALL_SUBRESOURCES;
-    b[nb].Transition.StateBefore = D3D12_RESOURCE_STATE_RENDER_TARGET;
+    b[nb].Transition.StateBefore = source_state;
     b[nb].Transition.StateAfter = D3D12_RESOURCE_STATE_NON_PIXEL_SHADER_RESOURCE;
     nb++;
     if (g_aa_state != D3D12_RESOURCE_STATE_UNORDERED_ACCESS) {
