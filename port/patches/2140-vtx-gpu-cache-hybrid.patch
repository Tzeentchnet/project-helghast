diff --git a/libs/video/rsx_vtx_gpu.h b/libs/video/rsx_vtx_gpu.h
index 4d29445..94ee6ee 100644
--- a/libs/video/rsx_vtx_gpu.h
+++ b/libs/video/rsx_vtx_gpu.h
@@ -128,6 +128,22 @@ typedef struct rsx_vg_draw {
 /* Why a draw stays on the CPU path ([vtx-gpu] log columns). */
 enum { RSX_VG_OK = 0, RSX_VG_NO_INPUTS, RSX_VG_DIVIDED, RSX_VG_UNMAPPED, RSX_VG_TYPE, RSX_VG_BIG, RSX_VG_REASONS };
 
+enum { RSX_VG_ROUTE_CPU, RSX_VG_ROUTE_GPU, RSX_VG_ROUTE_CACHE, RSX_VG_ROUTE_FILL };
+#define RSX_VG_CACHE_RETRY_FRAMES 60u
+
+static inline int rsx_vg_route(int gpu_enabled, int cache_hit, int cache_fill)
+{
+    if (cache_hit) return RSX_VG_ROUTE_CACHE;
+    if (cache_fill) return RSX_VG_ROUTE_FILL;
+    return gpu_enabled ? RSX_VG_ROUTE_GPU : RSX_VG_ROUTE_CPU;
+}
+
+static inline int rsx_vg_cache_wait(u32 frame, u32 retry_frame)
+{
+    const u32 remaining = retry_frame - frame;
+    return remaining != 0u && remaining <= RSX_VG_CACHE_RETRY_FRAMES;
+}
+
