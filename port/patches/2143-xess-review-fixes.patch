+/* Intel: XeSS-SR needs a mip bias of log2(input / target). The units of a scene draw that have a mip chain get it; the
+ * guest's own sampler stays if the cache is full (sampler_slot then answers the default sampler). */
+static void ld_xess_bias_samplers(u32 texture_mask, u32* smp_slots)
+{
+    if (!g_xess_mip_bias_fp) return;
+    for (u32 u = 0; u < SMP_TABLE_SIZE; u++) {
+        if (!((texture_mask >> u) & 1u)) continue;
+        rsx_dsp_texture t; rsx_dsp_get_texture(&g.rsx, u, &t);
+        const u32 minf = (t.filter >> 16) & 0x7u;
+        if (minf < 3u || minf > 6u) continue;   /* decode_sampler's mip_present */
+        t.filter = kz3_xess_filter_with_bias(t.filter, g_xess_mip_bias_fp);
+        u32 skey[4]; sampler_key(&t, skey);
+        const u32 slot = sampler_slot(&t, skey);
+        if (slot != SMP_DEFAULT) smp_slots[u] = slot;
+    }
+}
