+/* LD_WB_GPU_PACK=1 (default 0) packs batched readbacks on the GPU. The guest still waits and receives every byte. */
+static int ld_wb_gpu_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled < 0) {
+        const char* e = getenv("LD_WB_GPU_PACK");
+        const char* unsafe = getenv("LD_WB_UNSAFE_NOWAIT");
+        enabled = e && !strcmp(e, "1");
+        if (e && *e && strcmp(e, "0") && strcmp(e, "1"))
+            fprintf(stderr, "[wb-gpu-pack] invalid LD_WB_GPU_PACK=%s (expected 0 or 1); disabled\n", e);
+        if (enabled && unsafe && atoi(unsafe)) {
+            fprintf(stderr, "[wb-gpu-pack] disabled with LD_WB_UNSAFE_NOWAIT\n");
+            enabled = 0;
+        }
+        if (enabled) fprintf(stderr, "[wb-gpu-pack] enabled for batched readbacks\n");
+    }
+    return enabled;
+}
