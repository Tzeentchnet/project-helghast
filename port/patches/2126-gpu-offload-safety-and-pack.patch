+static int ld_wb_gpu_buffer(u32 k, u64 need)
+{
+    if (!need || need > 0x100000000ull) {
+        static u32 invalid_sizes;
+        if (++invalid_sizes <= 8u || !(invalid_sizes & (invalid_sizes - 1u)))
+            fprintf(stderr, "[wb-gpu-pack] unsupported buffer size=%llu; using CPU conversion\n",
+                    (unsigned long long)need);
+        return 0;
+    }
+    if (!ld_wb_gpu_pipeline()) return 0;
+    if (g_ld_wb_gpu_bytes[k] >= need) return 1;
+    if (g_ld_wb_gpu_buf[k]) {
+        g_ld_wb_gpu_buf[k]->lpVtbl->Release(g_ld_wb_gpu_buf[k]);
+        g_ld_wb_gpu_buf[k] = NULL; g_ld_wb_gpu_bytes[k] = 0;
+    }
+    const u64 bytes = (need + 0xFFFFFull) & ~0xFFFFFull;
+    D3D12_HEAP_PROPERTIES hp = {0}; hp.Type = D3D12_HEAP_TYPE_DEFAULT;
+    D3D12_RESOURCE_DESC bd = {0};
+    bd.Dimension = D3D12_RESOURCE_DIMENSION_BUFFER; bd.Width = bytes;
+    bd.Height = 1; bd.DepthOrArraySize = 1; bd.MipLevels = 1;
+    bd.Format = DXGI_FORMAT_UNKNOWN; bd.SampleDesc.Count = 1;
+    bd.Layout = D3D12_TEXTURE_LAYOUT_ROW_MAJOR;
+    bd.Flags = D3D12_RESOURCE_FLAG_ALLOW_UNORDERED_ACCESS;
+    HRESULT hr = g.dev->lpVtbl->CreateCommittedResource(g.dev, &hp, D3D12_HEAP_FLAG_NONE, &bd,
+        D3D12_RESOURCE_STATE_COPY_DEST, NULL, &IID_ID3D12Resource, (void**)&g_ld_wb_gpu_buf[k]);
+    if (FAILED(hr) || !g_ld_wb_gpu_buf[k]) {
+        if (SUCCEEDED(hr)) hr = E_FAIL;
+        static u32 failures;
+        if (++failures <= 8u || !(failures & (failures - 1u)))
+            fprintf(stderr, "[wb-gpu-pack] buffer allocation failed hr=0x%08lX bytes=%llu; using CPU conversion\n",
+                    (unsigned long)hr, (unsigned long long)bytes);
+        g_ld_wb_gpu_buf[k] = NULL;
+        return 0;
+    }
+    if (!g_ld_wb_gpu_buf[k]->lpVtbl->GetGPUVirtualAddress(g_ld_wb_gpu_buf[k])) {
+        fprintf(stderr, "[wb-gpu-pack] buffer has no GPU address; using CPU conversion\n");
+        g_ld_wb_gpu_buf[k]->lpVtbl->Release(g_ld_wb_gpu_buf[k]);
+        g_ld_wb_gpu_buf[k] = NULL;
+        return 0;
+    }
+    g_ld_wb_gpu_bytes[k] = bytes;
+    return 1;
+}
