+static inline u32 rsx_vg_ring_block_limit(u32 requested, u32 count, u32 ring_bytes)
+{
+    const u64 payload = (u64)count * sizeof(rsx_vertex_ref) + 256u;
+    if (payload >= ring_bytes) return 0u;
+    const u64 available = ring_bytes - payload;
+    return available < requested ? (u32)available : requested;
+}
+
+static inline int rsx_vg_cpu_fetch(const rsx_vertex_fetch_plan* p, const rsx_vertex_ref* refs, u32 count,
+                                   u8* dst, int batch)
+{
+    if (batch && p->layout.stride) return rsx_vertex_fetch_many(p, refs, count, dst);
+    for (u32 i = 0; i < count; i++) {
+        u8* out = p->layout.stride ? dst + (u64)i * p->layout.stride : NULL;
+        if (!rsx_vertex_fetch_one(p, &refs[i], out)) return 0;
+    }
+    return 1;
+}
