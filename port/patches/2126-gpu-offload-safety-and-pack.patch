new file mode 100644
index 0000000..3ba6f8a
--- /dev/null
+++ b/libs/video/rsx_wb_gpu.h
@@ -0,0 +1,43 @@
+/*
+ * Integer-only packing for batched surface readback. The GPU operates on
+ * the raw copied bytes, so float and half-float payloads are never converted.
+ */
+#ifndef PS3RECOMP_RSX_WB_GPU_H
+#define PS3RECOMP_RSX_WB_GPU_H
+
+#include <stdint.h>
+
+enum { RSX_WB_GPU_RGBA8, RSX_WB_GPU_HALF, RSX_WB_GPU_FLOAT };
+
+#define RSX_WB_GPU_CODE(...) __VA_ARGS__
+#define RSX_WB_GPU_TEXT(...) #__VA_ARGS__
+#define RSX_WB_GPU_WORD(X) X( \
+WB_FN uint rsx_wb_gpu_word(uint v, uint mode) { \
+    if (mode == 0u) return (v << 8u) | (v >> 24u); \
+    if (mode == 1u) return ((v & 0x00FF00FFu) << 8u) | ((v & 0xFF00FF00u) >> 8u); \
+    return (v >> 24u) | ((v >> 8u) & 0x0000FF00u) | ((v << 8u) & 0x00FF0000u) | (v << 24u); \
+} )
+
+#ifdef RSX_WB_GPU_C_REFERENCE
+typedef uint32_t rsx_wb_gpu_uint;
+#define uint rsx_wb_gpu_uint
+#define WB_FN static inline
+RSX_WB_GPU_WORD(RSX_WB_GPU_CODE)
+#undef WB_FN
+#undef uint
+#endif
+
+#define RSX_WB_GPU_HLSL \
+    "RWByteAddressBuffer wb : register(u0);\n" \
+    "cbuffer WBConstants : register(b0) { uint wb_words; uint wb_rows; uint wb_pitch; uint wb_mode; };\n" \
+    "#define WB_FN\n" \
+    RSX_WB_GPU_WORD(RSX_WB_GPU_TEXT) "\n" \
+    "[numthreads(8, 8, 1)]\n" \
+    "void main(uint3 id : SV_DispatchThreadID) {\n" \
+    "    if (id.x < wb_words && id.y < wb_rows) {\n" \
+    "        uint off = id.y * wb_pitch + id.x * 4u;\n" \
+    "        wb.Store(off, rsx_wb_gpu_word(wb.Load(off), wb_mode));\n" \
+    "    }\n" \
+    "}\n"
+
+#endif /* PS3RECOMP_RSX_WB_GPU_H */
