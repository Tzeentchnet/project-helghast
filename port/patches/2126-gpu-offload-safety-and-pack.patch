+static int ld_wb_gpu_pipeline(void)
+{
+    if (g_ld_wb_gpu_pso) return 1;
+    if (g_ld_wb_gpu_tried) return 0;
+    g_ld_wb_gpu_tried = 1;
+    static const char source[] = RSX_WB_GPU_HLSL;
+    ID3DBlob *cs = NULL, *sig = NULL, *err = NULL;
+    const char* stage = "shader";
+    HRESULT hr = D3DCompile(source, sizeof source - 1u, "writeback_pack", NULL, NULL, "main", "cs_5_0",
+                            D3DCOMPILE_OPTIMIZATION_LEVEL3, 0, &cs, &err);
+    if (FAILED(hr) || !cs) { if (SUCCEEDED(hr)) hr = E_FAIL; goto fail; }
+    if (err) { err->lpVtbl->Release(err); err = NULL; }
+    D3D12_ROOT_PARAMETER rp[2] = {0};
+    rp[0].ParameterType = D3D12_ROOT_PARAMETER_TYPE_UAV;
+    rp[0].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    rp[1].ParameterType = D3D12_ROOT_PARAMETER_TYPE_32BIT_CONSTANTS;
+    rp[1].Constants.Num32BitValues = 4;
+    rp[1].ShaderVisibility = D3D12_SHADER_VISIBILITY_ALL;
+    D3D12_ROOT_SIGNATURE_DESC rd = {0};
+    rd.NumParameters = 2; rd.pParameters = rp;
+    stage = "root signature serialization";
+    hr = D3D12SerializeRootSignature(&rd, D3D_ROOT_SIGNATURE_VERSION_1, &sig, &err);
+    if (FAILED(hr) || !sig) { if (SUCCEEDED(hr)) hr = E_FAIL; goto fail; }
+    if (err) { err->lpVtbl->Release(err); err = NULL; }
+    stage = "root signature";
+    hr = g.dev->lpVtbl->CreateRootSignature(g.dev, 0, sig->lpVtbl->GetBufferPointer(sig),
+                                            sig->lpVtbl->GetBufferSize(sig),
+                                            &IID_ID3D12RootSignature, (void**)&g_ld_wb_gpu_root);
+    if (FAILED(hr) || !g_ld_wb_gpu_root) { if (SUCCEEDED(hr)) hr = E_FAIL; goto fail; }
+    D3D12_COMPUTE_PIPELINE_STATE_DESC pd = {0};
+    pd.pRootSignature = g_ld_wb_gpu_root;
+    pd.CS.pShaderBytecode = cs->lpVtbl->GetBufferPointer(cs);
+    pd.CS.BytecodeLength = cs->lpVtbl->GetBufferSize(cs);
+    stage = "pipeline";
+    hr = g.dev->lpVtbl->CreateComputePipelineState(g.dev, &pd, &IID_ID3D12PipelineState,
+                                                   (void**)&g_ld_wb_gpu_pso);
+    if (FAILED(hr) || !g_ld_wb_gpu_pso) { if (SUCCEEDED(hr)) hr = E_FAIL; goto fail; }
+    sig->lpVtbl->Release(sig);
+    cs->lpVtbl->Release(cs);
+    return 1;
+fail:
+    fprintf(stderr, "[wb-gpu-pack] %s failed hr=0x%08lX: %s; using CPU conversion\n", stage, (unsigned long)hr,
+            err ? (const char*)err->lpVtbl->GetBufferPointer(err) : "<no diagnostics>");
+    if (err) err->lpVtbl->Release(err);
+    if (sig) sig->lpVtbl->Release(sig);
+    if (cs) cs->lpVtbl->Release(cs);
+    if (g_ld_wb_gpu_pso) { g_ld_wb_gpu_pso->lpVtbl->Release(g_ld_wb_gpu_pso); g_ld_wb_gpu_pso = NULL; }
+    if (g_ld_wb_gpu_root) { g_ld_wb_gpu_root->lpVtbl->Release(g_ld_wb_gpu_root); g_ld_wb_gpu_root = NULL; }
+    return 0;
+}
